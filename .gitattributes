* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Keep GitHub's language statistics focused on the application code.
design-assets/** linguist-vendored
public/fonts/** linguist-vendored
*.blade.php linguist-language=Blade
*.woff binary
*.woff2 binary
